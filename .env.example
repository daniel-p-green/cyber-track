# CyberTrack environment variables — all optional. Copy to .env if needed.
# Never commit real keys.

# Local model routing (defaults work with a standard Ollama install)
# CYBERTF_OLLAMA_BASE=http://localhost:11434
# CYBERTF_MODEL=gemma4:latest
# CYBERTF_OPENAI_BASE=http://localhost:1234/v1   # e.g. LM Studio local server

# Optional cloud fallback. Useful for testing when local hardware is unavailable,
# but not local/offline compliant for the judged CyberTrack demo path.
# CYBERTF_OPENAI_BASE=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# CYBERTF_MODEL=google/gemma-4-26b-a4b-it:free

# Web arena location for `cybertf publish`
# Local arena: CYBERTF_ARENA_URL=http://localhost:3000
# CYBERTF_ARENA_URL=http://localhost:3000

# Optional briefing audio polish. Static MP3s are committed for the demo; this
# is only needed when regenerating them or using --voice openai.
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=onyx
# CYBERTF_TTS_URL=
