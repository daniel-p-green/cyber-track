# CyberTrack environment variables — all optional. Copy to .env if needed.
# Never commit real keys.

# Local model routing (defaults work with a standard Ollama install)
# CYBERTF_OLLAMA_BASE=http://localhost:11434
# CYBERTF_MODEL=gemma4:latest
# CYBERTF_OPENAI_BASE=http://localhost:1234/v1   # e.g. LM Studio local server

# Development only: canned model responses, loudly labeled, scores zero on
# local/offline compliance. Never use for demos.
# CYBERTF_SIM=1

# Web arena location for `cybertf publish` (default http://localhost:3000)
# CYBERTF_ARENA_URL=http://localhost:3000

# Optional audio polish tier (offline macOS `say` is the default and needs no key)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
