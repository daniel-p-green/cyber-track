# CyberTrack environment variables — all optional. Copy to .env if needed.
# Never commit real keys.

# Local model routing (defaults work with a standard Ollama install)
# CYBERTF_OLLAMA_BASE=http://localhost:11434
# CYBERTF_MODEL=gemma4:latest
# CYBERTF_OPENAI_BASE=http://localhost:1234/v1   # e.g. LM Studio local server

# Development only: canned model responses, loudly labeled, scores zero on
# local/offline compliance. Never use for demos.
# CYBERTF_SIM=1

# Web arena location for `cybertf publish`
# Local dev:  CYBERTF_ARENA_URL=http://localhost:3000
# Production: CYBERTF_ARENA_URL=https://cybertrack-arena.vercel.app
# CYBERTF_ARENA_URL=http://localhost:3000

# Optional voice briefing tiers for web arena + CLI `--voice`
# Default offline path: macOS `say` (CLI) or pre-generated MP3s in web/public/audio/briefings/
#
# ElevenLabs (cloud polish, optional):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
#
# Local Piper (fully offline):
# PIPER_MODEL_PATH=/path/to/en_US-lessac-medium.onnx
#
# Local voice server (Piper/Kokoro/custom): POST {"text":"..."} → audio/mpeg bytes
# CYBERTF_TTS_URL=http://localhost:5500/tts
