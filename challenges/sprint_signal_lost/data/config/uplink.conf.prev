# HALCYON uplink gateway — previous configuration (rev 4790, applied 2026-06-20)
# Synthetic training data.

interface tunnel0
  link_mtu 1500
  keepalive_interval 10
  retry_backoff exponential
  fragmentation off
  compression lz4

radio
  tx_power 27
  channel_plan auto
  rssi_alarm_threshold -92

telemetry
  batch_size 64
  queue_depth 4096
  drop_policy oldest-first
