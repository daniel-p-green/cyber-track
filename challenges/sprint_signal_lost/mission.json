  "answer_fields": [
    { "key": "root_cause_parameter", "type": "string", "prompt": "Which configuration parameter caused the packet loss?" },
    { "key": "outage_start_utc", "type": "string", "prompt": "When (UTC, HH:MM) did the packet loss begin?" },
    { "key": "false_lead", "type": "string", "prompt": "What was the tempting false lead you ruled out?" },
    { "key": "ops_note", "type": "string", "prompt": "3-5 sentence operational note: root cause, evidence, fix, and what you ruled out." },
    { "key": "evidence", "type": "list", "prompt": "Workspace file paths that support your findings." }
  ],
